      "id": "SC-peak",
      "label": "Harvest week peak",
      "peak_factor": 4,
      "window": "2 hours/day for 7 days",
      "description": "Peak rates already listed per flow; queue backpressure monitored"
    },
    {
      "id": "SC-failure",
      "label": "Single replica or service-zone failure",
      "peak_factor": 1,
      "window": "event driven",
      "description": "N+1 / recovery analysis; P12 single instance has an explicit availability gap"
