{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ul-xdfd:schema:1.0",
  "title": "UL-xDFD v1.0 structural schema \u2014 AI and agentic extension",
  "description": "Proposed structural schema; conceptual rules, cost reconciliation and safety require independent semantic evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "metadata",
    "phases",
    "scenarios",
    "nodes",
    "edges",
    "annotations",
    "evidence"
  ],
  "properties": {
    "spec_version": {
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "revision",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "hypothetical",
            "draft",
            "reviewed",
            "frozen"
          ]
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L[0-9]{2}$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "environment",
          "phase_id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string"
          },
          "phase_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "assumptions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "X",
              "P",
              "S",
              "B",
              "IDEA",
              "VAL",
              "REQ",
              "USE",
              "EV",
              "G",
              "TEAM",
              "ROLE",
              "SKILL",
              "APP",
              "API",
              "REPO",
              "PIPE",
              "ART",
              "ENV",
              "DEP",
              "RES",
              "CC",
              "BILL",
              "RISK",
              "EVID",
              "OUT",
              "CHG",
              "AISYS",
              "MODEL",
              "MODELSVC",
              "AGENT",
              "AGRUN",
              "ORCH",
              "TOOL",
              "MCP",
              "A2A",
              "PROMPT",
              "CONTEXT",
              "CORPUS",
              "CHUNK",
              "VINDEX",
              "DATASET",
              "EXPER",
              "EVAL",
              "SAFE",
              "HITL",
              "GPU",
              "AICHARGE",
              "AIOUT"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "phase_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boundary_id": {
            "type": "string"
          },
          "tags": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "DATA",
              "DECOMP",
              "REQMAP",
              "WORK",
              "DEC",
              "OWN",
              "CONTR",
              "CODE",
              "DEL",
              "HOST",
              "RESUSE",
              "COST",
              "SEC",
              "EVID",
              "PHASE",
              "OUTCOME",
              "ALT",
              "INVOKES",
              "TOOLCALL",
              "RETRIEVES",
              "EMBEDS",
              "MODELDEP",
              "DELEGATE",
              "TRAINS",
              "EVALUATES",
              "POLICY",
              "AICOST",
              "AIRESULT"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "phase_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_id",
          "key",
          "value",
          "datatype",
          "scope",
          "status",
          "source_kind",
          "evidence_refs",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*$"
          },
          "value": {},
          "datatype": {
            "enum": [
              "number",
              "integer",
              "string",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "scope": {
            "type": "object",
            "required": [
              "scenario_id",
              "environment"
            ],
            "properties": {
              "scenario_id": {
                "type": "string"
              },
              "phase_id": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "window": {
                "type": "string"
              },
              "granularity": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "observed",
              "reported",
              "estimated",
              "derived",
              "hypothetical",
              "unknown",
              "disputed",
              "expired"
            ]
          },
          "source_kind": {
            "enum": [
              "telemetry",
              "artifact",
              "financial_record",
              "survey",
              "interview",
              "expert_estimate",
              "simulation",
              "derived",
              "benchmark",
              "policy"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_at": {
            "type": "string"
          },
          "uncertainty": {
            "type": "object"
          },
          "review": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "collected_at",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "collected_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "privacy_class": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_ids",
          "comparator",
          "value",
          "unit",
          "scenario_id",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comparator": {
            "enum": [
              "lt",
              "le",
              "eq",
              "ge",
              "gt"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ai_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "AI-INFERENCE",
          "AI-AGENT",
          "AI-RAG",
          "AI-TRAINING",
          "AI-ASSURANCE"
        ]
      }
    }
  }
}